// Orion OS : l'utilisateur « orion » (serveur matériel orion-server et session
// de l'interface) pilote le réseau, le modem, l'alimentation et ses propres
// services sans mot de passe. Le Bluetooth passe par le groupe « bluetooth ».
// JavaScript ES5 (moteur de polkit).
polkit.addRule(function (action, subject) {
    if (subject.user !== "orion") {
        return polkit.Result.NOT_HANDLED;
    }
    var id = action.id;
    if (id.indexOf("org.freedesktop.NetworkManager.") === 0 ||
        id.indexOf("org.freedesktop.ModemManager1.") === 0) {
        return polkit.Result.YES;
    }
    var power = [
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.reboot-ignore-inhibit",
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.power-off-ignore-inhibit",
        "org.freedesktop.login1.set-wall-message"
    ];
    if (power.indexOf(id) >= 0) {
        return polkit.Result.YES;
    }
    if (id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if ((unit === "orion-server.service" || unit === "orion-update.service") &&
            (verb === "start" || verb === "stop" || verb === "restart")) {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
